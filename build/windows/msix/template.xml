<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="noteit"
        Arguments=""
        InstallLocation="C:\Program Files\Gabriel Sequera\noteit">
    </Installer>
    <PackageInformation
        PackageName="noteit"
        PackageDisplayName="noteit"
        PublisherName="CN=Gabriel Sequera"
        PublisherDisplayName="Gabriel Sequera"
        Version="0.1.0.0"
        PackageDescription="Lightning-fast keyboard-driven notes for developers">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.gabosequera.noteit"
                Description="Lightning-fast keyboard-driven notes for developers"
                DisplayName="noteit"
                ExecutableName="noteit"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>noteit</DisplayName>
            <PublisherDisplayName>Gabriel Sequera</PublisherDisplayName>
            <Description>Lightning-fast keyboard-driven notes for developers</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="noteit.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
